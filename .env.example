# Database
DATABASE_URL=file:./dev.db
# JWT Security
JWT_SECRET=super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server Config
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# Storage (Local upload default, Cloudinary / Supabase ready)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
